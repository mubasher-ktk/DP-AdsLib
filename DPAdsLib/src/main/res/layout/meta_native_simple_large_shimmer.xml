<com.facebook.ads.NativeAdLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_ad_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#D9D9D9"
    android:clickable="false"
    android:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false">

        <androidx.cardview.widget.CardView
            android:id="@+id/adIconCard"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_100sdp"
            android:layout_margin="@dimen/_2sdp"
            android:clickable="true"
            android:elevation="0dp"
            app:cardBackgroundColor="@color/lightTransparent"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.facebook.ads.MediaView
                android:id="@+id/nativeAdIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="@color/lightTransparent"
                android:contentDescription="Ad Icon"
                android:scaleType="fitXY" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/nativeAdSponsoredLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:background="@drawable/ad_att_bg"
            android:backgroundTint="@color/lightTransparent"
            android:clickable="false"
            android:fontFamily="@font/poppins_extrabold"
            android:padding="@dimen/_3sdp"
            android:text="Sponsored"
            android:textColor="@color/White"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/nativeAdTitle"
            app:layout_constraintStart_toEndOf="@+id/adIconCard"
            app:layout_constraintTop_toTopOf="@+id/adIconCard" />

        <TextView
            android:id="@+id/nativeAdTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:ellipsize="marquee"
            android:fontFamily="@font/poppins_extrabold"
            android:lines="1"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:minEms="25"
            android:singleLine="true"
            android:background="@color/lightTransparent"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/nativeAdSponsoredLabel"
            app:layout_constraintEnd_toStartOf="@+id/glNativeAdmobSmall2"
            app:layout_constraintStart_toEndOf="@+id/nativeAdSponsoredLabel"
            app:layout_constraintTop_toTopOf="@+id/nativeAdSponsoredLabel" />

        <TextView
            android:id="@+id/nativeAdSocialContext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/poppins_medium"
            android:background="@color/lightTransparent"
            android:textColor="@color/black"
            android:textSize="10sp"
            app:layout_constraintBottom_toTopOf="@+id/nativeAdBody"
            app:layout_constraintEnd_toStartOf="@+id/glNativeAdmobSmall2"
            app:layout_constraintStart_toEndOf="@+id/adIconCard"
            app:layout_constraintTop_toBottomOf="@+id/nativeAdTitle" />

        <TextView
            android:id="@+id/nativeAdBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:lines="2"
            android:maxLines="2"
            android:minEms="90"
            android:background="@color/lightTransparent"
            android:textColor="#D8000000"
            android:textSize="10sp"
            app:layout_constraintBottom_toTopOf="@+id/nativeAdCallToAction"
            app:layout_constraintEnd_toStartOf="@+id/glNativeAdmobSmall2"
            app:layout_constraintStart_toEndOf="@+id/adIconCard"
            app:layout_constraintTop_toBottomOf="@+id/nativeAdSocialContext" />

        <Button
            android:id="@+id/nativeAdCallToAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_2sdp"
            android:background="@drawable/ad_att_btn_bg"
            android:backgroundTint="@color/lightTransparent"
            android:fontFamily="@font/poppins_medium"
            android:textAllCaps="false"
            android:textColor="@color/White"
            android:textStyle="bold"
            app:cornerRadius="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/glNativeAdmobSmall2"
            app:layout_constraintStart_toStartOf="@+id/nativeAdBody"
            app:layout_constraintTop_toBottomOf="@+id/nativeAdBody" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glNativeAdmobSmall2"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.95" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.ads.NativeAdLayout>